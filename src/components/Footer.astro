---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsConfig, CmsConfigContactLink } from '../lib/data';
import { href } from '../lib/paths';
import IconLink from "./IconLink.astro";

interface Props {
	config?: CmsConfig | null;
}

const { config } = Astro.props;
const seo = config?.seo ?? null;
const contactLinks = (config?.contactLinks ?? []).filter(
	(item): item is CmsConfigContactLink => item !== null,
);
const today = new Date();
---
<footer class="border-t bg-background py-10 text-center text-sm text-muted-foreground">
	<div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-6">
		{contactLinks.length > 0 && (
			<div class="flex justify-center gap-4">
				{contactLinks.map((link) => (
					<IconLink
						title={link.title}
						link={link.link}
						icon={link.icon}
						data-tina-field={tinaField(link, "title")}
					/>
				))}
			</div>
		)}
		<p>
			&copy; {today.getFullYear()}
			<span data-tina-field={seo ? tinaField(seo, "siteOwner") : undefined}>{seo?.siteOwner ?? 'Viaggio in Perù'}</span>
			· Costa → Arequipa → Colca → Cusco
		</p>
		<p class="text-xs">
			Contenuti su GitHub · editor <a class="text-primary hover:underline" href={href('/admin/index.html')}>TinaCMS</a>
		</p>
	</div>
</footer>
