---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
	title?: string | null;
	link?: string | null;
	icon?: string | null;
};

const { title, link, icon: _icon, ...rest } = Astro.props;
const safeTitle = title ?? '';
const safeLink = link ?? '#';
---

<a href={safeLink} target="_blank" rel="noopener noreferrer" aria-label={safeTitle} class="text-sm text-muted-foreground hover:text-foreground" {...rest}>
	{safeTitle}
</a>
