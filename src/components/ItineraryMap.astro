---
export interface MapMarker {
	day: number;
	title: string;
	focus?: string | null;
	overnight?: string | null;
	placeName: string;
	lat: number;
	lng: number;
	href: string;
}

interface Props {
	markers: MapMarker[];
	height?: string;
}

const { markers, height = "min(70vh, 560px)" } = Astro.props;
const payload = JSON.stringify(markers);
---

<div
	id="peru-map"
	class="w-full overflow-hidden rounded-2xl border border-border shadow-sm"
	style={`height: ${height}`}
	data-markers={payload}
	data-base={import.meta.env.BASE_URL}
	role="region"
	aria-label="Mappa interattiva dell'itinerario"
></div>

<link
	rel="stylesheet"
	href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
	integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
	crossorigin=""
/>

<script is:inline>
	(function () {
		const el = document.getElementById("peru-map");
		if (!el || el.dataset.mapReady === "1") return;
		el.dataset.mapReady = "1";

		const markers = JSON.parse(el.dataset.markers || "[]");
		if (!markers.length) {
			el.innerHTML =
				'<p class="flex h-full items-center justify-center p-6 text-sm text-muted-foreground">Nessun punto mappa disponibile.</p>';
			return;
		}

		const load = () => {
			const L = window.L;
			const map = L.map(el, { scrollWheelZoom: false });
			L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
				maxZoom: 18,
				attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
			}).addTo(map);

			const latLngs = [];
			const sorted = markers.slice().sort((a, b) => a.day - b.day);

			sorted.forEach((m) => {
				const ll = [m.lat, m.lng];
				latLngs.push(ll);
				const popup = [
					"<strong>Giorno " + m.day + "</strong>",
					"<div>" + m.title + "</div>",
					m.placeName ? "<div>" + m.placeName + "</div>" : "",
					m.focus ? '<div style="margin-top:4px;opacity:.85">' + m.focus + "</div>" : "",
					m.overnight ? "<div><em>Pernottamento:</em> " + m.overnight + "</div>" : "",
					m.href
						? '<div style="margin-top:6px"><a href="' + m.href + '">Apri giorno →</a></div>'
						: "",
				]
					.filter(Boolean)
					.join("");
				L.marker(ll).addTo(map).bindPopup(popup);
			});

			if (latLngs.length > 1) {
				L.polyline(latLngs, { color: "#c45c26", weight: 3, opacity: 0.75 }).addTo(map);
			}

			map.fitBounds(L.latLngBounds(latLngs).pad(0.2));
		};

		if (window.L) {
			load();
			return;
		}

		const s = document.createElement("script");
		s.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
		s.integrity = "sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=";
		s.crossOrigin = "";
		s.onload = load;
		document.head.appendChild(s);
	})();
</script>

<style>
	#peru-map :global(.leaflet-container) {
		font: inherit;
		z-index: 0;
	}
	#peru-map :global(.leaflet-popup-content) {
		margin: 10px 12px;
		line-height: 1.35;
	}
</style>
