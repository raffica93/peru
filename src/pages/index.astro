---
import Base from '../layouts/Base.astro';
import Checklist from '../components/Checklist.astro';
import ItineraryMap from '../components/ItineraryMap.astro';
import Prose from '../components/Prose.astro';
import { getConfig, getTrip, listGiorni, listTappe } from '../lib/data';
import { href } from '../lib/paths';

const config = (await getConfig()).data?.config ?? null;
const trip = (await getTrip()).data?.trip;
if (!trip) return new Response('Trip not found', { status: 404 });

const giorni = await listGiorni();
const tappe = await listTappe();

const markers = giorni
	.filter((g) => typeof g.lat === 'number' && typeof g.lng === 'number')
	.map((g) => ({
		day: g.day ?? 0,
		title: g.title,
		focus: g.focus,
		overnight: g.overnight,
		placeName: g.placeName,
		lat: g.lat as number,
		lng: g.lng as number,
		href: href(`/giorni/${g._sys.filename}`),
	}));

const title = trip.title || config?.seo?.title || 'Viaggio in Perù';
const description =
	config?.seo?.description ||
	`${trip.period} · ${trip.participants} adulti · ${trip.routeSummary}`;
---

<Base title={title} description={description}>
	<section class="relative overflow-hidden border-b border-border bg-gradient-to-br from-amber-50 via-background to-orange-50 dark:from-background dark:via-background dark:to-orange-950/20">
		<div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
			<p class="text-sm font-medium tracking-wide text-primary uppercase">Itinerario operativo</p>
			<h1 class="mt-2 max-w-3xl text-3xl font-bold tracking-tight md:text-5xl">{trip.title}</h1>
			<p class="mt-4 max-w-2xl text-lg text-muted-foreground">
				{trip.period}
				{trip.periodPeru && <span> · In Perù: {trip.periodPeru}</span>}
			</p>
			<div class="mt-6 flex flex-wrap gap-3 text-sm">
				<span class="rounded-full border border-border bg-card px-3 py-1">{trip.participants} adulti</span>
				{trip.routeSummary && (
					<span class="rounded-full border border-border bg-card px-3 py-1">{trip.routeSummary}</span>
				)}
				{trip.nightsSummary && (
					<span class="rounded-full border border-border bg-card px-3 py-1">{trip.nightsSummary}</span>
				)}
			</div>
			<div class="mt-8 flex flex-wrap gap-3">
				<a href={href('/mappa')} class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:opacity-90">Apri mappa</a>
				<a href={href('/tappe')} class="rounded-lg border border-border bg-card px-4 py-2 text-sm font-medium hover:bg-accent">Tappe</a>
				<a href={href('/giorni')} class="rounded-lg border border-border bg-card px-4 py-2 text-sm font-medium hover:bg-accent">Giorno per giorno</a>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-10">
		<div class="mb-4 flex items-end justify-between gap-4">
			<div>
				<h2 class="text-2xl font-semibold">Mappa itinerario</h2>
				<p class="text-sm text-muted-foreground">Marker per ogni giorno con coordinate</p>
			</div>
			<a href={href('/mappa')} class="text-sm text-primary hover:underline">Schermo intero →</a>
		</div>
		<ItineraryMap markers={markers} height="420px" />
	</section>

	<section class="mx-auto max-w-6xl px-6 py-6">
		<h2 class="mb-4 text-2xl font-semibold">Calendario operativo</h2>
		<div class="overflow-x-auto rounded-2xl border border-border">
			<table class="w-full min-w-[640px] text-left text-sm">
				<thead class="bg-muted/60 text-muted-foreground">
					<tr>
						<th class="px-4 py-3 font-medium">Giorno</th>
						<th class="px-4 py-3 font-medium">Data</th>
						<th class="px-4 py-3 font-medium">Focus</th>
						<th class="px-4 py-3 font-medium">Pernottamento</th>
					</tr>
				</thead>
				<tbody>
					{giorni.map((g) => (
						<tr class="border-t border-border/70 hover:bg-muted/30">
							<td class="px-4 py-3">
								<a class="font-medium text-primary hover:underline" href={href(`/giorni/${g._sys.filename}`)}>
									{g.day}. {g.placeName}
								</a>
							</td>
							<td class="px-4 py-3 whitespace-nowrap text-muted-foreground">
								{g.date ? new Date(g.date).toLocaleDateString('it-IT', { day: 'numeric', month: 'short' }) : '—'}
							</td>
							<td class="px-4 py-3">{g.focus}</td>
							<td class="px-4 py-3">{g.overnight}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-6">
		<div class="mb-4 flex items-end justify-between">
			<h2 class="text-2xl font-semibold">Tappe</h2>
			<a href={href('/tappe')} class="text-sm text-primary hover:underline">Tutte →</a>
		</div>
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{tappe.map((t) => (
				<a
					href={href(`/tappe/${t._sys.filename}`)}
					class="group rounded-2xl border border-border bg-card p-5 shadow-sm transition hover:border-primary/40 hover:shadow-md"
				>
					<p class="text-xs font-medium tracking-wide text-primary uppercase">Tappa {t.order}</p>
					<h3 class="mt-1 text-lg font-semibold group-hover:text-primary">{t.title}</h3>
					{t.period && <p class="mt-2 text-sm text-muted-foreground">{t.period}</p>}
					{t.route && <p class="mt-1 text-sm text-muted-foreground">{t.route}</p>}
				</a>
			))}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-6">
		<h2 class="mb-4 text-2xl font-semibold">Prenotazioni confermate</h2>
		<ul class="space-y-2 rounded-2xl border border-border bg-card p-5 text-sm">
			{(trip.bookingsSummary ?? []).filter(Boolean).map((item) => (
				<li class="flex gap-2">
					<span class="text-primary">✓</span>
					<span>{item}</span>
				</li>
			))}
		</ul>
		<p class="mt-3 text-xs text-muted-foreground">
			Codici PNR e voucher non sono pubblicati sul sito (repo pubblico). Restano su email/PDF offline.
		</p>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-6">
		<h2 class="mb-4 text-2xl font-semibold">Checklist</h2>
		<div class="grid gap-4 md:grid-cols-2">
			<Checklist title="Alloggi" items={trip.checklistAlloggi} />
			<Checklist title="Trasporti e logistica" items={trip.checklistTrasporti} />
			<Checklist title="Attività" items={trip.checklistAttivita} />
			<Checklist title="Documenti e verifiche" items={trip.checklistDocumenti} />
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-6 pb-14">
		<h2 class="mb-4 text-2xl font-semibold">Alloggi candidati</h2>
		<div class="overflow-x-auto rounded-2xl border border-border">
			<table class="w-full min-w-[520px] text-left text-sm">
				<thead class="bg-muted/60 text-muted-foreground">
					<tr>
						<th class="px-4 py-3 font-medium">Località</th>
						<th class="px-4 py-3 font-medium">Date</th>
						<th class="px-4 py-3 font-medium">Struttura</th>
					</tr>
				</thead>
				<tbody>
					{(trip.hotels ?? []).filter(Boolean).map((h) => (
						<tr class="border-t border-border/70">
							<td class="px-4 py-3 font-medium">{h?.location}</td>
							<td class="px-4 py-3 text-muted-foreground">{h?.dates}</td>
							<td class="px-4 py-3">{h?.name}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
		<div class="mt-6">
			<Prose content={trip.body} />
		</div>
	</section>
</Base>
