---
import Base from '../layouts/Base.astro';
import { href } from '../lib/paths';
---
<Base title="Pagina non trovata (404)" description="Questa pagina non esiste.">
	<section class="mx-auto flex min-h-[60vh] max-w-xl flex-col items-center justify-center px-6 text-center">
		<p class="text-sm font-medium tracking-widest text-primary uppercase">Errore 404</p>
		<h1 class="mt-2 text-3xl font-semibold tracking-tight">Pagina non trovata</h1>
		<p class="mt-4 text-muted-foreground">Il percorso non esiste o è stato spostato.</p>
		<a href={href('/')} class="mt-8 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:opacity-90">
			Torna alla home
		</a>
	</section>
</Base>
