---
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import { getConfig, getPagina, listPagine } from '../../lib/data';
import { href } from '../../lib/paths';

export async function getStaticPaths() {
	const pagine = await listPagine();
	return pagine.map((p) => ({
		params: { slug: p._sys.filename },
	}));
}

const { slug } = Astro.params;
const config = (await getConfig()).data?.config ?? null;
const pagina = (await getPagina(slug!)).data?.pagine;
if (!pagina) return new Response('Not found', { status: 404 });
---

<Base
	title={`${pagina.title} · ${config?.seo?.title ?? 'Perù'}`}
	description={pagina.description || pagina.title}
>
	<article class="mx-auto max-w-3xl px-6 py-10">
		<p class="text-sm font-medium text-primary">Pagina operativa</p>
		<h1 class="mt-1 text-3xl font-bold tracking-tight md:text-4xl">{pagina.title}</h1>
		{pagina.description && <p class="mt-3 text-muted-foreground">{pagina.description}</p>}
		<div class="mt-8">
			<Prose content={pagina.body} />
		</div>
		<p class="mt-10 text-sm">
			<a href={href('/')} class="text-primary hover:underline">← Torna alla home</a>
		</p>
	</article>
</Base>
